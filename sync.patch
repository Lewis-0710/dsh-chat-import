--- a/lib/purge.mjs
+++ b/lib/purge.mjs
@@ -7,10 +7,11 @@
 //（0.8.3 起日志不再写 session/imported 标记，归属以 registry 为权威，issue #34；
 // 旧日志标记仍作正向证据）。
 
-import { access, readdir, rm } from 'node:fs/promises'
+import { access, readdir, rm, unlink } from 'node:fs/promises'
 import { homedir } from 'node:os'
 import { join } from 'node:path'
 import { loadImports, removeImport, saveImports, unwrapRecord, readSessionEvents, canReadSessionEvents } from './imports.mjs'
+import { clearScanCache, SCAN_CACHE_FILE } from './discovery.mjs'
 
 // DSH 会话 id 合法字符：支持字母、数字、连字符以及下划线（mintSessionId 会引入下划线），长 1~128。
 const SESSION_ID_RE = /^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$/
@@ -367,3 +368,27 @@ export async function purgeBySourcePath(ctx, registryDir, sourcePath, { confirm
   await removeImport(registryDir, sourcePath)
   return { sourcePath, deleted, failed, results }
 }
+
+/** 删除源文件（.jsonl 等）+ 清 registry 记录 + 清扫描缓存。无论是否已导入都执行。 */
+export async function deleteSourceFile(ctx, registryDir, sourcePath) {
+  if (typeof sourcePath !== 'string' || !sourcePath) {
+    throw new Error('缺少 sourcePath')
+  }
+  let sourceDeleted = false
+  try {
+    await unlink(sourcePath)
+    sourceDeleted = true
+  } catch {
+    // 文件不存在或删除失败——继续清 registry
+  }
+  await removeImport(registryDir, sourcePath)
+  // 清扫描缓存：防止删除后 30s TTL 内存缓存 / 持久化书签让条目重现
+  clearScanCache()
+  // 清持久化书签文件（scan-cache.json），下次扫描会重建
+  try {
+    await rm(join(registryDir, SCAN_CACHE_FILE), { force: true })
+  } catch {
+    // 文件不存在——忽略
+  }
+  return { sourcePath, sourceDeleted }
+}
